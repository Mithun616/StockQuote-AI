# ==============================================================================
# StockQuote AI - Backend Environment Template
# Copy this file to .env and provide your deployment-specific configuration.
# NEVER commit real credentials, signing keys, or tokens to version control.
# ==============================================================================

# Microsoft Azure AI Foundry Configuration
AZURE_AI_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/YourProjectName
AZURE_AGENT_NAME=StockQuoteAgent
AZURE_MODEL_DEPLOYMENT=gpt-5-mini

# Azure Logic App HTTP POST Trigger URL
# Format: https://prod-XX.eastus.logic.azure.com:443/workflows/<WORKFLOW_ID>/triggers/manual/paths/invoke?api-version=...
LOGIC_APP_URL=https://prod-XX.eastus.logic.azure.com:443/workflows/YOUR_WORKFLOW_ID/triggers/manual/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=YOUR_SIGNATURE

# Azure Table Storage Cache Configuration
TABLE_STORAGE_ACCOUNT=yourstorageaccount
TABLE_STORAGE_TABLE=StockQuotes
CACHE_TTL_MARKET_HOURS_SECONDS=14400
CACHE_TTL_OFF_HOURS_SECONDS=86400
TABLE_STORAGE_READ_SAS=

# Cryptographic Provenance & Backend Authentication
# 256-bit cryptographically secure HMAC signing key (64 hex characters)
PROVENANCE_SIGNING_KEY=your_256_bit_hmac_secret_key_here
# Backend-to-Logic-App authentication token for header 'x-backend-auth-token'
BACKEND_LOGIC_APP_AUTH_TOKEN=your_backend_to_logic_app_auth_secret_here

# Operational Flags
HOST=0.0.0.0
PORT=8000
ALLOW_MOCK_FALLBACK=false
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.azurestaticapps.net
